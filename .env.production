# Production build defaults.
#
# !! REPLACE THE URL BELOW BEFORE THE FIRST REAL DEPLOY. !!
#
# The value here is a placeholder that exists so `npm run build` succeeds
# locally. Vercel project environment variables take precedence over this
# file, so the correct production setup is:
#
#   Vercel -> Project -> Settings -> Environment Variables
#     VITE_API_BASE_URL = https://<your-api-host>/api
#     VITE_ENVIRONMENT  = production
#
# If those are set in Vercel, this file is ignored on deploy. If they are NOT
# set, you will ship a bundle pointing at the placeholder and every request
# will fail visibly with "Could not reach the API".
#
# Whatever origin the dashboard is served from must also be added to
# CORS_ORIGINS in the backend's .env - the dev proxy does not exist in prod.
VITE_API_BASE_URL=https://api.example.com/api
VITE_ENVIRONMENT=production
