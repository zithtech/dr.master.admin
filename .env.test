# Environment for `vitest`, which runs in Vite's "test" mode and therefore
# loads this file rather than `.env.development`.
#
# Committed so the suite runs on a fresh clone and in CI with no setup. Tests
# mock the HTTP layer, so this URL is never actually requested - it exists to
# satisfy the required-var guard in src/shared/config/env.ts.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_ENVIRONMENT=development
