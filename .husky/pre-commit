# Abort the commit as soon as any check fails.
#
# Without `set -e` the hook runs every command and exits with the status of the
# LAST one, so a lint-staged failure would be silently swallowed and the broken
# commit would go through - which defeats the point of the hook.
set -e

# Lint + format, staged files only. This is the fast path: it scales with the
# size of the change, not the size of the repo.
npx lint-staged

# tsc has no staged-files mode - it must see the whole program - but it is the
# only thing here that catches cross-file breakage, e.g. a renamed export that
# lint-staged never looks at because the *consumer* was not staged.
npm run typecheck
