# Copy to `.env.local` and adjust. `.env.local` is gitignored; this file is committed.
#
# NOTE: nothing here is a secret. Vite inlines every VITE_* var into the
# client bundle, so anything below is readable by anyone who opens devtools.
# Real secrets belong on the backend - never in this file.
#
# Vite loads, in increasing precedence:
#   .env -> .env.[mode] -> .env.local -> .env.[mode].local
# Committed defaults for dev and production already live in `.env.development`
# and `.env.production`; use `.env.local` for personal overrides.

# Base URL for the API, including the /api prefix.
#
# Leave as the relative `/api` for local dev: vite.config.ts proxies it to
# http://localhost:4000, which makes requests same-origin and sidesteps CORS
# entirely. Set an absolute https:// origin for staging/production, and add
# that origin to CORS_ORIGINS in the backend's .env.
VITE_API_BASE_URL=/api

# One of: development | staging | production
# Anything other than `production` shows an environment badge in the header.
VITE_ENVIRONMENT=development
